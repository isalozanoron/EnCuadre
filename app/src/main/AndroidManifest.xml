<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" android:exported="false"/>
        <activity android:name=".RegistroActivity" android:exported="false"/>
        <activity android:name=".PlaceholderActivity" android:exported="false"/>
        <activity android:name=".PerfilActivity" android:exported="false"/>
        <activity android:name=".NotificacionesActivity" android:exported="false"/>
        <activity android:name=".BandejaNotificacionesActivity" android:exported="false"/>
        <activity android:name=".MaratonPendienteActivity" android:exported="false"/>

        <!-- Push Banner: implementado como notificación real del sistema
             (PushNotificationHelper.java), disparado automáticamente desde
             SplashActivity — no es una Activity aparte -->

        <activity android:name=".HomeActivity" android:exported="false"/>
        <activity android:name=".MisFuncionesActivity" android:exported="false"/>
        <activity android:name=".MiFuncionActivity" android:exported="false"/>
        <activity android:name=".AlarmaSalidaActivity" android:exported="false"/>
        <activity android:name=".RecomendacionActivity" android:exported="false"/>
        <activity android:name=".EstrenoActivity" android:exported="false"/>
        <activity android:name=".HorariosActivity" android:exported="false"/>
        <activity android:name=".AjustesActivity" android:exported="false"/>
        <activity android:name=".ModoSilencioActivity" android:exported="false"/>

    </application>
</manifest>