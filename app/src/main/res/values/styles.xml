<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.EnCuadre.FigmaButton" parent="Widget.AppCompat.Button">
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:singleLine">true</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.009375</item>
        <item name="backgroundTint">@null</item>
    </style>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/encuadre_acento</item>
        <item name="colorPrimaryDark">@color/encuadre_fondo</item>
        <item name="colorAccent">@color/encuadre_acento</item>
        <item name="android:windowBackground">@color/encuadre_fondo</item>
        <item name="android:textColorHint">@color/encuadre_texto_secundario</item>
    </style>

    <style name="ShapeAppearance.EnCuadre.Logo" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Diálogo oscuro estilo EnCuadre (ej. "Recuperar contraseña") -->
    <style name="EnCuadreDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/encuadre_fondo</item>
        <item name="colorOnSurface">@color/encuadre_blanco</item>
        <item name="colorPrimary">@color/encuadre_acento</item>
        <item name="materialAlertDialogTitleTextStyle">@style/EnCuadreDialogTitleStyle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/EnCuadreDialogBodyStyle</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.EnCuadre.Dialog</item>
    </style>

    <style name="EnCuadreDialogTitleStyle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/encuadre_blanco</item>
        <item name="android:textSize">21sp</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="EnCuadreDialogBodyStyle" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/encuadre_texto_secundario</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ShapeAppearance.EnCuadre.Dialog" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Chip de género (Perfil): estado inicial "no seleccionado", se cambia a mano en Java -->
    <style name="Widget.EnCuadre.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip_normal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/encuadre_texto_secundario</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="ShapeAppearance.EnCuadre.FunctionCard" parent=""><item name="cornerSizeTopLeft">0dp</item><item name="cornerSizeTopRight">0dp</item><item name="cornerSizeBottomLeft">12dp</item><item name="cornerSizeBottomRight">12dp</item></style></resources>
