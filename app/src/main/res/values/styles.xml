<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/encuadre_acento</item>
        <item name="colorPrimaryDark">@color/encuadre_fondo</item>
        <item name="colorAccent">@color/encuadre_acento</item>
        <item name="android:windowBackground">@color/encuadre_fondo</item>
        <item name="android:textColorHint">@color/encuadre_texto_secundario</item>
    </style>

    <style name="ShapeAppearance.EnCuadre.Logo" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Diálogo oscuro estilo EnCuadre (ej. "Recuperar contraseña") -->
    <style name="EnCuadreDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/encuadre_fondo</item>
        <item name="colorOnSurface">@color/encuadre_blanco</item>
        <item name="colorPrimary">@color/encuadre_acento</item>
        <item name="materialAlertDialogTitleTextStyle">@style/EnCuadreDialogTitleStyle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/EnCuadreDialogBodyStyle</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.EnCuadre.Dialog</item>
    </style>

    <style name="EnCuadreDialogTitleStyle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/encuadre_blanco</item>
        <item name="android:textSize">21sp</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="EnCuadreDialogBodyStyle" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/encuadre_texto_secundario</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ShapeAppearance.EnCuadre.Dialog" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">28dp</item>
    </style>
</resources>