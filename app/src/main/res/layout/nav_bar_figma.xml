<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/nav_bar_bottom" android:layout_width="match_parent" android:layout_height="64dp" android:background="@color/encuadre_superficie" android:orientation="horizontal">
