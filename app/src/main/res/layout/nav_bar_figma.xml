    <LinearLayout android:id="@+id/nav_item_ajustes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="top|center_horizontal" android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
