<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/encuadre_fondo"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/placeholder_titulo"
        android:textColor="@color/encuadre_texto_principal"
        android:textSize="21sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_nombre_pantalla"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_nombre_pantalla"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/encuadre_texto_secundario"
        android:textSize="14sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_titulo"
        app:layout_constraintBottom_toTopOf="@id/btn_volver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp"
        tools:text="Inicio (pantalla de Juan)"/>

    <Button
        android:id="@+id/btn_volver"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_button_outline"
        android:text="@string/placeholder_volver"
        android:textAllCaps="false"
        android:textColor="@color/encuadre_acento"
        app:layout_constraintTop_toBottomOf="@id/tv_nombre_pantalla"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
