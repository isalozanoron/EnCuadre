<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/encuadre_fondo"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- Campana de notificaciones: en el Figma real de Inicio, así se llega a
         Bandeja de notificaciones. Se replica aquí porque Inicio (de Juan)
         todavía no existe. -->
    <ImageButton
        android:id="@+id/btn_notificaciones"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_notification_bell"
        app:tint="@color/encuadre_texto_principal"
        android:contentDescription="Abrir notificaciones"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/placeholder_titulo"
        android:textColor="@color/encuadre_texto_principal"
        android:textSize="21sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_nombre_pantalla"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_nombre_pantalla"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/encuadre_texto_secundario"
        android:textSize="14sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_titulo"
        app:layout_constraintBottom_toTopOf="@id/btn_volver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp"
        tools:text="Inicio (pantalla de Juan)"/>

    <Button
        android:id="@+id/btn_volver"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_button_outline"
        android:text="@string/placeholder_volver"
        android:textAllCaps="false"
        android:textColor="@color/encuadre_acento"
        app:layout_constraintTop_toBottomOf="@id/tv_nombre_pantalla"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SOLO PARA PRUEBAS — quitar antes del commit final.
         Atajo para llegar a Perfil sin pelear con "Specified Activity" de Android Studio. -->
    <include
        android:id="@+id/nav_bar_bottom"
        android:layout_width="0dp"
        android:layout_height="64dp"
        layout="@layout/nav_bar_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>