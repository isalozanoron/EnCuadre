<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/encuadre_fondo"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_logo"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="60dp"
        android:scaleType="centerCrop"
        android:src="@drawable/logo_encuadre"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.EnCuadre.Logo"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_marca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/app_name"
        android:textColor="@color/encuadre_texto_principal"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/iv_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_subtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/login_subtitulo"
        android:textColor="@color/encuadre_texto_secundario"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tv_marca"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Campo Correo: vista propia, no TextInputLayout (control total de bordes/etiqueta/estado).
         La etiqueta va como hermano (no hijo) del contenedor, superpuesta encima del borde,
         para que nada la recorte. -->
    <FrameLayout
        android:id="@+id/campo_correo"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_campo_normal"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/et_correo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="48dp"
            android:background="@null"
            android:gravity="center_vertical"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:textColor="@color/encuadre_texto_principal"
            android:textCursorDrawable="@drawable/cursor_login"
            android:textSize="14sp"/>

        <ImageView
            android:id="@+id/iv_estado_correo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_clear_field"
            app:tint="@color/encuadre_texto_secundario"
            android:contentDescription="@string/label_correo"/>

    </FrameLayout>

    <TextView
        android:id="@+id/tv_label_correo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="-9dp"
        android:background="@color/encuadre_fondo"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/label_correo"
        android:textColor="@color/encuadre_texto_secundario"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/campo_correo"
        app:layout_constraintStart_toStartOf="@id/campo_correo"/>

    <!-- Campo Contraseña: sin ícono a la derecha (fiel a Figma) -->
    <FrameLayout
        android:id="@+id/campo_contrasena"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_campo_normal"
        app:layout_constraintTop_toBottomOf="@id/campo_correo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/et_contrasena"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@null"
            android:gravity="center_vertical"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/encuadre_texto_principal"
            android:textCursorDrawable="@drawable/cursor_login"
            android:textSize="14sp"/>

    </FrameLayout>

    <TextView
        android:id="@+id/tv_label_contrasena"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="-9dp"
        android:background="@color/encuadre_fondo"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/label_contrasena"
        android:textColor="@color/encuadre_texto_secundario"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/campo_contrasena"
        app:layout_constraintStart_toStartOf="@id/campo_contrasena"/>

    <!-- Mensaje de error: solo aparece bajo Contraseña, como en el mockup -->
    <TextView
        android:id="@+id/tv_error_contrasena"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="16dp"
        android:text="@string/error_campos_vacios"
        android:textColor="@color/encuadre_texto_principal"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/campo_contrasena"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Boton principal: NO estirado, se ajusta al texto y queda centrado. Texto oscuro sobre fondo acento. -->
    <Button
        android:id="@+id/btn_iniciar_sesion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minWidth="180dp"
        android:background="@drawable/bg_button_primary"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="@string/accion_iniciar_sesion"
        android:textAllCaps="false"
        android:textColor="@color/encuadre_fondo"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tv_error_contrasena"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ProgressBar
        android:id="@+id/progress_login"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="90dp"
        android:indeterminateTint="@color/encuadre_acento"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_olvidaste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:padding="8dp"
        android:text="@string/accion_olvidaste_contrasena"
        android:textColor="@color/encuadre_texto_secundario"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/btn_iniciar_sesion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- "Crear cuenta": borde Superficie (no Acento), texto Acento, ancho ajustado al contenido -->
    <Button
        android:id="@+id/btn_registrarse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_outline"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="@string/accion_crear_cuenta"
        android:textAllCaps="false"
        android:textColor="@color/encuadre_acento"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tv_olvidaste"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>